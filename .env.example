DATABASE_URL=postgresql+psycopg://mediation:mediation-dev-only@localhost:5432/mediation
S3_BUCKET=mediation-documents
S3_REGION=us-west-2
S3_ENDPOINT_URL=http://s3mock:5000
# Required for production case-data access; use an AWS KMS customer-managed key.
S3_KMS_KEY_ID=
# Local demo defaults to Moto's test credentials. For AWS, use a dedicated IAM
# identity with only the required bucket, KMS, and Bedrock permissions.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SESSION_TOKEN=
CASE_DATA_ENABLED=false
CASE_MATERIALS_ENABLED=false
# Enable only in a deployment that intends to serve production case data.
# Case-data APIs fail closed until every readiness check, including separate
# qualified-counsel and AI-provider evidence when AI is enabled, passes. Keep false
# for local/demo use; production must explicitly enable it.
PRODUCTION_READINESS_REQUIRED=false
# Set true only after a qualified attorney has reviewed the exact materials and
# versioned evidence recorded in Spec 51's checklist. This flag is not an approval.
COUNSEL_REVIEW_EVIDENCE_VERIFIED=false
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=200
# Enable only after user-facing disclosures, Bedrock settings, and provider handling
# evidence are reviewed. AI remains unavailable in production until both counsel and
# provider review evidence flags are set; flags are operator assertions, not proof.
AI_ANALYSIS_ENABLED=false
# Set true only after signed/current provider evidence is recorded in the Spec 52
# checklist. This flag is not proof of provider behavior or legal approval.
AI_PROVIDER_REVIEW_EVIDENCE_VERIFIED=false
BEDROCK_MODEL_ID=
BEDROCK_REGION=
AI_ANALYSIS_NOTICE_VERSION=
# Supply the exact deployment-specific handling notice for the selected provider/model.
# It must state evidence-backed retention, human access/review, product-improvement and
# training settings, subprocessors, and deletion terms; unknowns must remain explicit.
AI_ANALYSIS_DATA_HANDLING_NOTICE=
SETTLEMENT_PLANNING_DATA_HANDLING_NOTICE=
# Optional until the operator configures a real support destination.
# Must be an HTTPS URL with no embedded credentials, query, or fragment.
SUPPORT_CONTACT_URL=
# Before production, map stable failure_event log codes in the deployment's
# existing log/alert platform. No monitoring provider or route is selected here.
# FAILURE_ALERT_SEV1_ROUTE=
# FAILURE_ALERT_SEV2_ROUTE=
# FAILURE_ALERT_GROUPING_WINDOW=
# FAILURE_ALERT_GROUPING_THRESHOLD=
# FAILURE_ALERT_SEV1_RESPONSE_TARGET=
# FAILURE_ALERT_SEV2_RESPONSE_TARGET=
# ON_CALL_OWNER=

# Keep demo mode enabled unless real authentication is configured.
AUTH_ENABLED=true
AUTH_JWT_SECRET=local-demo-only-signing-secret-not-for-production-123
AUTH_ISSUER=http://localhost:8000
AUTH_PUBLIC_BASE_URL=http://localhost:8000
AUTH_COOKIE_SECURE=true
AUTH_ENCRYPTION_KEY=
DEMO_MODE_ENABLED=true
AUTH_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_ATTEMPT_CREDITS_5=
STRIPE_PRICE_ID_ATTEMPT_CREDITS_10=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Casework
WEBAUTHN_ORIGIN=http://localhost:8000
