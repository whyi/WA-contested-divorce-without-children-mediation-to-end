DATABASE_URL=postgresql+psycopg://mediation:mediation-dev-only@localhost:5432/mediation
S3_BUCKET=mediation-documents
S3_REGION=us-west-2
S3_ENDPOINT_URL=http://s3mock:5000
# Required for production case-data access; use an AWS KMS customer-managed key.
S3_KMS_KEY_ID=
# Local demo defaults to Moto's test credentials. For AWS, use a dedicated IAM
# identity with only the required bucket, KMS, and Bedrock permissions.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SESSION_TOKEN=
CASE_DATA_ENABLED=false
CASE_MATERIALS_ENABLED=false
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=200
# Enable only after Bedrock model access and the deployment's data-handling notice are reviewed.
AI_ANALYSIS_ENABLED=false
BEDROCK_MODEL_ID=
BEDROCK_REGION=
AI_ANALYSIS_NOTICE_VERSION=
AI_ANALYSIS_DATA_HANDLING_NOTICE=
SETTLEMENT_PLANNING_DATA_HANDLING_NOTICE=

# Keep demo mode enabled unless real authentication is configured.
AUTH_ENABLED=true
AUTH_JWT_SECRET=local-demo-only-signing-secret-not-for-production-123
AUTH_ISSUER=http://localhost:8000
AUTH_PUBLIC_BASE_URL=http://localhost:8000
AUTH_COOKIE_SECURE=true
DEMO_MODE_ENABLED=true
AUTH_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Casework
WEBAUTHN_ORIGIN=http://localhost:8000
